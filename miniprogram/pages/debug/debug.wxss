.discover-page {
  overflow: hidden;
}

.hero {
  position: relative;
  min-height: 310rpx;
  margin-bottom: 24rpx;
  padding: 42rpx 36rpx;
  overflow: hidden;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(145deg, #172a58 0%, #344bb2 55%, #6b59ee 100%);
  border-radius: 36rpx;
  box-shadow: 0 24rpx 52rpx rgba(36, 56, 134, 0.25);
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  opacity: 0.34;
  filter: blur(2rpx);
}

.hero-orb-a {
  top: -100rpx;
  right: -40rpx;
  width: 300rpx;
  height: 300rpx;
  background: #8bf3ff;
}

.hero-orb-b {
  right: 200rpx;
  bottom: -170rpx;
  width: 330rpx;
  height: 330rpx;
  background: #9275ff;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.eyebrow {
  margin-bottom: 18rpx;
  color: #bdebf8;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero-copy {
  max-width: 570rpx;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.65;
}

.status-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
  font-size: 24rpx;
}

.status-dot {
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
}

.status-dot.ready {
  background: #74f0bc;
  box-shadow: 0 0 0 7rpx rgba(116, 240, 188, 0.16);
}

.status-dot.offline {
  background: #ffb9c3;
}

.status-dot.pulse {
  animation: pulse 1.6s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(0.78); }
}

.error-banner {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  color: #a42e41;
  font-size: 25rpx;
  background: #fff0f2;
  border: 1rpx solid #ffd7dc;
  border-radius: 22rpx;
}

.error-help {
  color: #bd6875;
  font-size: 22rpx;
}

.scan-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.scan-heading switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.filter-label {
  margin: -30rpx 86rpx 0 0;
  color: #7a8798;
  font-size: 22rpx;
  text-align: right;
}

.scan-button {
  margin-top: 26rpx;
  font-size: 27rpx;
}

.device-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(31, 52, 79, 0.08);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 34rpx rgba(55, 84, 122, 0.07);
}

.device-top {
  display: flex;
  align-items: center;
}

.device-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  flex-shrink: 0;
  color: #ffffff;
  background: linear-gradient(145deg, #3978f4, #6758e8);
  border-radius: 24rpx;
}

.bluetooth-mark {
  font-size: 42rpx;
  transform: rotate(6deg);
}

.device-main {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.device-name {
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-id {
  margin-top: 6rpx;
  overflow: hidden;
  color: #8290a1;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signal {
  display: grid;
  grid-template-columns: repeat(4, 6rpx);
  align-items: end;
  gap: 4rpx;
  height: 50rpx;
  margin-left: 14rpx;
}

.signal .bar {
  width: 6rpx;
  background: #d8dee8;
  border-radius: 6rpx;
}

.bar-1 { height: 10rpx; }
.bar-2 { height: 17rpx; }
.bar-3 { height: 24rpx; }
.bar-4 { height: 31rpx; }

.signal-1 .bar-1,
.signal-2 .bar-1, .signal-2 .bar-2,
.signal-3 .bar-1, .signal-3 .bar-2, .signal-3 .bar-3,
.signal-4 .bar {
  background: #42c59a;
}

.signal text {
  grid-column: 1 / 5;
  color: #8a96a5;
  font-size: 18rpx;
  white-space: nowrap;
  transform: translateX(-15rpx);
}

.advertisement {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  background: #f6f8fb;
  border-radius: 18rpx;
}

.advert-row {
  display: flex;
  gap: 14rpx;
  margin-top: 7rpx;
}

.advert-row:first-child {
  margin-top: 0;
}

.advert-label {
  flex-shrink: 0;
  color: #53647a;
  font-size: 20rpx;
  font-weight: 700;
}

.advert-value {
  min-width: 0;
  color: #748196;
  font-size: 19rpx;
}

.one-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.connect-button {
  margin-top: 22rpx;
  font-size: 26rpx;
}

.empty-radar {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
}

.radar-ring,
.radar-core {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.radar-ring {
  border: 2rpx solid #b9c8e9;
}

.ring-one { width: 80rpx; height: 80rpx; }
.ring-two { width: 130rpx; height: 130rpx; opacity: 0.45; }

.radar-core {
  width: 18rpx;
  height: 18rpx;
  background: #536af0;
  box-shadow: 0 0 0 10rpx rgba(83, 106, 240, 0.12);
}

.privacy-note {
  padding: 18rpx 28rpx;
  color: #8490a0;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}
