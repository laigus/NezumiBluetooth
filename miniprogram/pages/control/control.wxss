.control-page { padding-bottom: 90rpx; }
.device-hero { padding: 34rpx 32rpx 30rpx; color: #fff; background: linear-gradient(145deg,#172b4d,#355c9b 58%,#586bd5); border-radius: 36rpx; box-shadow: 0 20rpx 48rpx rgba(40,75,133,.23); }
.device-topline, .device-meta, .device-actions, .library-heading, .frequency-top, .frequency-name-row, .frequency-actions { display: flex; align-items: center; }
.device-topline, .library-heading, .frequency-top { justify-content: space-between; }
.device-state { display: flex; align-items: center; font-size: 21rpx; font-weight: 700; }
.state-dot { width: 14rpx; height: 14rpx; margin-right: 11rpx; background: #ffb8c2; border-radius: 50%; }
.state-dot.online { background: #68edb8; box-shadow: 0 0 0 8rpx rgba(104,237,184,.12); }
.device-protocol { color: rgba(255,255,255,.55); font-size: 18rpx; }
.device-name { margin-top: 22rpx; font-size: 46rpx; font-weight: 800; }
.device-connection { margin-top: 8rpx; color: rgba(255,255,255,.7); font-size: 23rpx; }
.device-meta { margin-top: 14rpx; color: rgba(255,255,255,.54); font-size: 19rpx; }
.device-meta text + text { margin-left: 24rpx; }
.device-actions { margin-top: 28rpx; }
.device-actions button { display: flex; height: 76rpx; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; line-height: 1.2; border-radius: 20rpx; }
.manual-button { color: #fff; background: rgba(101,111,236,.7); border: 1rpx solid rgba(255,255,255,.2); }
.import-button { color: #294a87; background: rgba(255,255,255,.94); }
.import-button { margin-left: 14rpx !important; }
.secondary-actions { margin-top: 14rpx; }
.disconnect-button { color: #ffe4e8; background: rgba(255,109,127,.16); border: 1rpx solid rgba(255,216,222,.26); }
.error-banner { margin-top: 22rpx; padding: 20rpx 24rpx; color: #a42e41; font-size: 23rpx; background: #fff0f2; border: 1rpx solid #ffd7dc; border-radius: 20rpx; }
.library-heading { margin: 38rpx 4rpx 18rpx; }
.frequency-count { color: #7f8a9b; font-size: 22rpx; }
.frequency-card { margin-bottom: 18rpx; padding: 26rpx 24rpx 22rpx; background: #fff; border: 2rpx solid transparent; border-radius: 29rpx; box-shadow: 0 11rpx 32rpx rgba(55,84,122,.07); }
.frequency-card.active { border-color: #7775e3; box-shadow: 0 14rpx 36rpx rgba(84,80,205,.14); }
.frequency-copy { min-width: 0; flex: 1; }
.frequency-name-row { min-width: 0; }
.frequency-name { min-width: 0; overflow: hidden; color: #263248; font-size: 30rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.origin-tag { flex-shrink: 0; margin-left: 12rpx; padding: 4rpx 10rpx; color: #5965c8; font-size: 17rpx; background: #edf0ff; border-radius: 9rpx; }
.frequency-description { display: block; margin-top: 8rpx; color: #7c8899; font-size: 21rpx; line-height: 1.55; }
.frequency-meta { display: block; margin-top: 9rpx; color: #9aa4b2; font-size: 19rpx; }
.detail-arrow { margin-left: 18rpx; color: #747ed4; font-size: 43rpx; }
.runtime-status { display: flex; align-items: center; margin-top: 18rpx; padding: 12rpx 15rpx; color: #535dc2; font-size: 20rpx; background: #f0f1ff; border-radius: 14rpx; }
.runtime-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; background: #6a68dc; border-radius: 50%; animation: blink 1.2s infinite; }
@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
.time-progress { margin-top: 11rpx; }
.progress-copy { display: flex; align-items: center; justify-content: space-between; color: #7d87a0; font-size: 18rpx; }
.progress-track { height: 10rpx; margin-top: 8rpx; overflow: hidden; background: #e7eaf3; border-radius: 999rpx; }
.progress-fill { height: 100%; background: linear-gradient(90deg,#3475ed,#7164df); border-radius: 999rpx; transition: width .2s linear; }
.loop-option { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 14rpx 16rpx; color: #7c8799; background: #f4f6fa; border-radius: 16rpx; }
.loop-label { display: flex; align-items: center; font-size: 21rpx; }
.loop-icon { margin-right: 9rpx; color: #70798b; font-size: 30rpx; line-height: 1; }
.loop-switch { position: relative; width: 66rpx; height: 36rpx; background: #cdd3dc; border-radius: 999rpx; transition: background .18s ease; }
.loop-knob { position: absolute; top: 4rpx; left: 4rpx; width: 28rpx; height: 28rpx; background: #fff; border-radius: 50%; box-shadow: 0 2rpx 7rpx rgba(35,45,65,.2); transition: transform .18s ease; }
.loop-option.enabled { color: #545dc2; background: #eff0ff; }
.loop-option.enabled .loop-icon { color: #5f62d2; }
.loop-option.enabled .loop-switch { background: #6568d7; }
.loop-option.enabled .loop-knob { transform: translateX(30rpx); }
.frequency-actions { margin-top: 20rpx; }
.frequency-actions button { display: flex; height: 72rpx; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 25rpx; line-height: 1.2; border-radius: 19rpx; }
.start-action { color: #fff; background: linear-gradient(135deg,#3475ed,#6258de); }
.stop-action { margin-left: 13rpx !important; color: #c33d51; background: #fff0f2; }
.frequency-actions button[disabled] { color: #aeb5bf !important; background: #eff1f4 !important; }
