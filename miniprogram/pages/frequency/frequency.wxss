.frequency-page { display: flex; height: 100vh; min-height: 0; padding: 18rpx 24rpx 20rpx; overflow: hidden; flex-direction: column; box-sizing: border-box; }
.frequency-page .card { flex-shrink: 0; margin: 0 0 12rpx; padding: 18rpx 22rpx; }
.frequency-hero { flex-shrink: 0; margin-bottom: 12rpx; padding: 24rpx 28rpx 20rpx; color: #fff; background: linear-gradient(145deg,#252d54,#514da5 56%,#7866d7); border-radius: 30rpx; box-shadow: 0 14rpx 34rpx rgba(63,58,143,.2); }
.hero-top, .hero-metrics, .card-head, .wave-axis, .detail-grid, .runtime-head, .run-actions { display: flex; align-items: center; }
.hero-top, .card-head, .wave-axis, .runtime-head { justify-content: space-between; }
.origin-tag, .connection-tag { padding: 5rpx 11rpx; font-size: 17rpx; border-radius: 10rpx; }
.origin-tag { color: #e5e4ff; background: rgba(255,255,255,.12); }
.connection-tag { color: #ffd6dd; background: rgba(255,113,134,.13); }
.connection-tag.online { color: #a9f7d5; background: rgba(91,237,181,.13); }
.frequency-name { margin-top: 14rpx; font-size: 39rpx; font-weight: 800; }
.frequency-description { margin-top: 7rpx; color: rgba(255,255,255,.68); font-size: 20rpx; line-height: 1.4; }
.hero-metrics { margin-top: 17rpx; padding-top: 15rpx; border-top: 1rpx solid rgba(255,255,255,.13); }
.hero-metric { display: flex; width: 44%; flex-direction: column; }
.metric-value { font-size: 24rpx; font-weight: 800; }
.metric-label { margin-top: 2rpx; color: rgba(255,255,255,.55); font-size: 16rpx; }
.metric-divider { width: 1rpx; height: 38rpx; margin-right: 24rpx; background: rgba(255,255,255,.18); }
.error-banner { flex-shrink: 0; margin-bottom: 12rpx; padding: 12rpx 18rpx; color: #a42e41; font-size: 20rpx; background: #fff0f2; border: 1rpx solid #ffd7dc; border-radius: 16rpx; }
.action-card { background: #fff; }
.runtime-status { display: flex; align-items: center; color: #515d72; font-size: 21rpx; }
.runtime-percent { color: #5963cb; font-size: 20rpx; font-weight: 700; }
.status-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; background: #a9b1bd; border-radius: 50%; }
.status-dot.running { background: #6565d8; animation: pulse 1.2s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
.detail-progress { margin-top: 9rpx; }
.progress-time { display: block; color: #858fa1; font-size: 17rpx; }
.progress-track { height: 10rpx; margin-top: 7rpx; overflow: hidden; background: #e7eaf3; border-radius: 999rpx; }
.progress-fill { height: 100%; background: linear-gradient(90deg,#3475ed,#7164df); border-radius: 999rpx; transition: width .2s linear; }
.run-actions { margin-top: 13rpx; }
.run-actions button { display: flex; height: 68rpx; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; line-height: 1.2; border-radius: 18rpx; }
.start-button { color: #fff; background: linear-gradient(135deg,#3475ed,#6258de); }
.stop-button { margin-left: 12rpx !important; color: #c43c51; background: #fff0f2; }
.run-actions button[disabled] { color: #aeb5bf !important; background: #eff1f4 !important; }
.waveform-card { display: flex; min-height: 210rpx; flex: 1 1 auto !important; flex-direction: column; overflow: hidden; }
.card-head { flex-shrink: 0; }
.section-title { font-size: 25rpx; }
.section-subtitle { margin-top: 3rpx; font-size: 18rpx; line-height: 1.35; }
.range-tag { padding: 5rpx 10rpx; color: #5c63c7; font-size: 16rpx; background: #eef0ff; border-radius: 9rpx; }
.waveform-chart { display: flex; min-height: 105rpx; flex: 1; align-items: flex-end; margin-top: 12rpx; padding: 10rpx 8rpx 0; background: linear-gradient(180deg,#f8f9fe,#eff2f9); border-radius: 16rpx; }
.wave-column { display: flex; min-width: 2rpx; height: 100%; flex: 1; align-items: flex-end; margin: 0 1rpx; }
.wave-fill { width: 100%; min-height: 6rpx; background: linear-gradient(180deg,#7464e4,#3478ed); border-radius: 5rpx 5rpx 2rpx 2rpx; }
.wave-axis { flex-shrink: 0; margin-top: 5rpx; color: #98a2b0; font-size: 16rpx; }
.detail-card { padding-top: 15rpx !important; padding-bottom: 13rpx !important; }
.detail-grid { flex-wrap: wrap; margin-top: 5rpx; }
.detail-item { display: flex; width: 50%; padding: 6rpx 0; flex-direction: column; }
.detail-label { color: #909baa; font-size: 16rpx; }
.detail-value { margin-top: 2rpx; color: #2f3b50; font-size: 20rpx; font-weight: 700; }
.export-button { display: flex; height: 68rpx; flex-shrink: 0; align-items: center; justify-content: center; margin: 0; padding: 0; color: #4f5fc4; font-size: 22rpx; line-height: 1.2; background: #e9edff; border-radius: 18rpx; }
