<view class="page-shell device-manager-page">
  <view class="manager-hero">
    <view class="hero-eyebrow">DEVICE MANAGER</view>
    <view class="hero-title">设备管理</view>
    <view class="hero-copy">这里只显示当前已连接的设备。点击设备后进入专属频率控制。</view>
    <view class="hero-status">
      <view class="status-dot {{connectedDevices.length ? 'connected' : (scanning ? 'scanning' : 'idle')}}"></view>
      <view class="status-copy">
        <text class="status-title">{{statusTitle}}</text>
        <text class="status-detail">{{statusDetail}}</text>
      </view>
    </view>
  </view>

  <view class="error-banner" wx:if="{{errorText}}">{{errorText}}</view>

  <view class="section-row">
    <view>
      <view class="section-title">当前连接</view>
      <view class="section-subtitle">{{connectedDevices.length}} 台设备</view>
    </view>
    <view class="count-pill">{{connectedDevices.length}}</view>
  </view>

  <view class="connected-list" wx:if="{{connectedDevices.length}}">
    <view class="connected-device" wx:for="{{connectedDevices}}" wx:key="deviceId" data-id="{{item.deviceId}}" bindtap="openDevice">
      <view class="device-icon"><view class="bluetooth-glyph">ᛒ</view></view>
      <view class="device-content">
        <view class="device-title-row">
          <text class="device-name">{{item.name}}</text>
          <text class="connected-badge">已连接</text>
        </view>
        <text class="device-service">{{item.serviceText}}</text>
        <view class="device-meta"><text>{{item.rssiText}}</text><text>{{item.mtuText}}</text></view>
      </view>
      <text class="device-arrow">›</text>
    </view>
  </view>

  <view class="card empty-device" wx:else>
    <view class="empty-radar">
      <view class="radar-ring ring-a"></view>
      <view class="radar-ring ring-b"></view>
      <view class="radar-core"></view>
    </view>
    <view class="empty-title">还没有已连接设备</view>
    <view class="empty-copy">确认设备已开机，并先退出其他正在连接它的控制端。</view>
    <button class="primary-button connect-button" loading="{{connecting || scanning}}" disabled="{{connecting}}" bindtap="retryConnection">
      {{connecting ? '正在连接' : (scanning ? '正在扫描' : '扫描并连接')}}
    </button>
  </view>

  <view class="manager-note">下方“高级调试”用于发现和分析其他 BLE 设备。</view>
</view>
