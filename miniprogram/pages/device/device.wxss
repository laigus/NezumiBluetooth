.device-page {
  padding-bottom: 100rpx;
}

.device-hero {
  position: relative;
  margin-bottom: 24rpx;
  padding: 34rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(150deg, #142a4f 0%, #274b91 62%, #396cd7 100%);
  border-radius: 36rpx;
  box-shadow: 0 22rpx 50rpx rgba(31, 65, 128, 0.24);
}

.hero-grid {
  position: absolute;
  inset: 0;
  opacity: 0.12;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.45) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.45) 1rpx, transparent 1rpx);
  background-size: 42rpx 42rpx;
  mask-image: linear-gradient(120deg, transparent 5%, #000 90%);
}

.device-hero-top,
.device-title,
.device-identifier,
.metric-row {
  position: relative;
}

.device-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-emblem {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #bcecff;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 22rpx;
}

.connection-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
}

.pill-dot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
}

.connection-pill.online .pill-dot {
  background: #5be6ae;
  box-shadow: 0 0 0 7rpx rgba(91, 230, 174, 0.12);
}

.connection-pill.offline .pill-dot {
  background: #ff9da9;
}

.device-title {
  margin-top: 28rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.device-identifier {
  margin-top: 8rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.66);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-row {
  display: flex;
  align-items: stretch;
  margin-top: 34rpx;
  padding: 22rpx 12rpx;
  background: rgba(12, 30, 66, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 22rpx;
}

.metric {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.metric-value {
  font-size: 30rpx;
  font-weight: 750;
}

.metric-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 19rpx;
}

.metric-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.14);
}

.error-banner {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  color: #a52f42;
  font-size: 24rpx;
  background: #fff0f2;
  border-radius: 20rpx;
}

.program-card {
  overflow: hidden;
  border: 2rpx solid #dfe6ff;
  box-shadow: 0 18rpx 44rpx rgba(52, 79, 157, 0.12);
}

.program-status {
  margin-top: 24rpx;
  padding: 22rpx;
  background: linear-gradient(135deg, #f1f5ff, #f7f9ff);
  border-radius: 20rpx;
}

.program-status-head,
.program-details {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.program-status-text {
  color: #2e467e;
  font-size: 24rpx;
  font-weight: 700;
}

.program-progress-value {
  color: #4a64ce;
  font-size: 23rpx;
  font-weight: 800;
}

.program-progress-track {
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  background: #dce4f8;
  border-radius: 999rpx;
}

.program-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6378e8, #5ac1d7);
  border-radius: 999rpx;
  transition: width 160ms linear;
}

.program-details {
  margin-top: 12rpx;
  color: #7887a0;
  font-size: 20rpx;
}

.program-option {
  margin-top: 20rpx;
}

.program-copy {
  display: flex;
  flex-direction: column;
  padding: 0 4rpx;
}

.program-name {
  color: #263b62;
  font-size: 28rpx;
  font-weight: 800;
}

.program-description {
  margin-top: 8rpx;
  color: #66768c;
  font-size: 22rpx;
  line-height: 1.55;
}

.program-evidence {
  margin-top: 8rpx;
  color: #8a96a8;
  font-size: 20rpx;
}

.program-start,
.program-stop {
  width: 100%;
  margin-top: 18rpx;
  font-size: 27rpx;
}

.program-stop {
  margin-bottom: 0;
}

.channel-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 18rpx;
}

.channel-label {
  flex-shrink: 0;
  padding: 5rpx 13rpx;
  color: #315ed0;
  font-size: 20rpx;
  font-weight: 700;
  background: #eaf0ff;
  border-radius: 10rpx;
}

.notify-label {
  color: #13886e;
  background: #e5f8f2;
}

.channel-value {
  color: #59697e;
  font-size: 21rpx;
  line-height: 1.65;
}

.command-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.command-button {
  width: 100%;
  margin: 0;
  font-size: 25rpx;
}

.mode-switch {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 6rpx;
  background: #edf1f7;
  border-radius: 16rpx;
}

.mode-option {
  min-width: 106rpx;
  padding: 12rpx 20rpx;
  box-sizing: border-box;
  color: #6e7b8d;
  font-size: 23rpx;
  font-weight: 650;
  text-align: center;
  border-radius: 12rpx;
}

.mode-option.active {
  color: #2f55bf;
  background: #ffffff;
  box-shadow: 0 5rpx 14rpx rgba(45, 67, 112, 0.12);
}

.payload-input {
  width: 100%;
  height: 180rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  box-sizing: border-box;
  color: #25364d;
  font-size: 25rpx;
  line-height: 1.6;
  background: #f5f7fb;
  border: 1rpx solid #e1e6ee;
  border-radius: 20rpx;
}

.send-button {
  margin-top: 20rpx;
  font-size: 27rpx;
}

.saved-list {
  margin-top: 22rpx;
}

.saved-command {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 18rpx 16rpx 18rpx 20rpx;
  background: #f6f8fc;
  border-radius: 18rpx;
}

.saved-command-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.saved-name {
  font-size: 25rpx;
  font-weight: 700;
}

.saved-hex {
  margin-top: 6rpx;
  overflow: hidden;
  color: #738198;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delete-command {
  flex-shrink: 0;
  color: #c14b5c;
  font-size: 20rpx;
  background: #ffeaed;
}

.new-command {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf0f4;
}

.command-input {
  height: 78rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  background: #f5f7fb;
  border: 1rpx solid #e1e6ee;
  border-radius: 17rpx;
}

.add-command {
  width: 100%;
  margin: 0;
  font-size: 25rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.clear-link,
.expand-icon {
  flex-shrink: 0;
  color: #4966c5;
  font-size: 23rpx;
  font-weight: 650;
}

.packet-list {
  max-height: 620rpx;
  margin-top: 20rpx;
  overflow-y: auto;
}

.packet {
  margin-bottom: 12rpx;
  padding: 18rpx;
  background: #f7f9fc;
  border-left: 5rpx solid #c8d3e5;
  border-radius: 6rpx 16rpx 16rpx 6rpx;
}

.packet-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #8290a1;
  font-size: 18rpx;
}

.direction {
  padding: 3rpx 9rpx;
  font-size: 18rpx;
  font-weight: 800;
  border-radius: 8rpx;
}

.direction.rx {
  color: #08785f;
  background: #ddf6ee;
}

.direction.tx {
  color: #3455b8;
  background: #e5ebff;
}

.packet-hex {
  margin-top: 10rpx;
  color: #253851;
  font-size: 22rpx;
  line-height: 1.6;
}

.packet-text {
  margin-top: 7rpx;
  color: #77869a;
  font-size: 21rpx;
  word-break: break-all;
}

.compact-empty {
  padding: 32rpx 16rpx;
  color: #8995a4;
  font-size: 23rpx;
  text-align: center;
}

.traffic-actions {
  margin-top: 22rpx;
}

.traffic-actions button {
  font-size: 23rpx;
}

.service {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f6f8fb;
  border: 1rpx solid #e5e9f0;
  border-radius: 20rpx;
}

.service-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.service-badge {
  padding: 5rpx 10rpx;
  color: #3a58ad;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  background: #e7edff;
  border-radius: 8rpx;
}

.service-short {
  margin-left: 10rpx;
  color: #253750;
  font-size: 23rpx;
  font-weight: 700;
}

.service-count {
  color: #8491a2;
  font-size: 20rpx;
}

.service-uuid,
.characteristic-uuid {
  margin-top: 10rpx;
  color: #8995a4;
  font-size: 18rpx;
}

.service-error {
  margin-top: 12rpx;
  color: #bc4052;
  font-size: 21rpx;
}

.characteristic {
  margin-top: 16rpx;
  padding: 17rpx;
  background: #ffffff;
  border: 1rpx solid #e5e9f0;
  border-radius: 16rpx;
}

.characteristic.selected-write {
  border-color: #90a5f5;
  box-shadow: inset 5rpx 0 #5c70e6;
}

.characteristic.selected-notify {
  background: linear-gradient(90deg, #f0fbf8, #ffffff 45%);
}

.characteristic-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.characteristic-short {
  color: #2c3f59;
  font-size: 22rpx;
  font-weight: 700;
}

.capabilities {
  color: #65758a;
  font-size: 19rpx;
}

.characteristic-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.mini-action {
  margin: 0;
  color: #53647a;
  font-size: 20rpx;
  background: #edf1f6;
}

.mini-action.active-action {
  color: #ffffff;
  background: #5b6ee1;
}

.mini-action.notify-action {
  color: #08785f;
  background: #dff6ef;
}

.refresh-gatt {
  margin-top: 22rpx;
  font-size: 24rpx;
}

.diagnostic-card {
  max-height: 480rpx;
  overflow-y: auto;
}

.log-row {
  display: grid;
  grid-template-columns: 150rpx 62rpx 1fr;
  gap: 10rpx;
  margin-top: 13rpx;
  color: #657489;
  font-size: 19rpx;
  line-height: 1.5;
}

.log-time {
  color: #8a96a6;
}

.log-level {
  font-weight: 700;
  text-transform: uppercase;
}

.level-rx { color: #0b8568; }
.level-tx { color: #3e5bc1; }
.level-warn { color: #bd6b22; }

.log-message {
  word-break: break-all;
}

.disconnect-button {
  margin-top: 12rpx;
  font-size: 26rpx;
}
