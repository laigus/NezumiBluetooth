page {
  min-height: 100%;
  background: #f4f7fb;
  color: #182230;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
}

button {
  border-radius: 20rpx;
  font-weight: 600;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
  box-sizing: border-box;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(31, 52, 79, 0.08);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 40rpx rgba(55, 84, 122, 0.08);
}

.section-title {
  color: #182230;
  font-size: 30rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #6d7b8d;
  font-size: 24rpx;
  line-height: 1.55;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, #2864ff, #6458f5);
  box-shadow: 0 12rpx 24rpx rgba(55, 88, 230, 0.22);
}

.secondary-button {
  color: #3155a5;
  background: #edf2ff;
}

.danger-button {
  color: #c83f51;
  background: #fff0f2;
}

.ghost-button {
  color: #4e6077;
  background: #f1f4f8;
}

.button-row {
  display: flex;
  gap: 16rpx;
}

.button-row button {
  flex: 1;
  margin: 0;
}

.mono {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  word-break: break-all;
}

.muted {
  color: #738196;
}

.empty-state {
  padding: 56rpx 24rpx;
  color: #7c8999;
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
}
